# ---------- PayPal (free sandbox) ----------
# Leave empty to use the built-in, API-compatible simulator (no account needed).
# developer.paypal.com → Apps & Credentials → Sandbox → your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox            # sandbox | mock (auto: sandbox when credentials are set)
# PAYPAL_WEBHOOK_ID=            # optional: webhook id for signature verification
# PUBLIC_URL=http://localhost:8787   # used for PayPal return/cancel URLs (set to your Render URL when deployed)

# ---------- AI (any OpenAI-compatible endpoint) ----------
# Default: local Ollama (free).   ollama pull qwen2.5:7b
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:7b
AI_API_KEY=ollama
# Examples:
# AI_BASE_URL=https://api.x.ai/v1        AI_MODEL=grok-4-fast   AI_API_KEY=xai-...
# AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini   AI_API_KEY=sk-...

# ---------- Verification ----------
WHISPER_MODEL=small        # tiny | base | small | medium
AUTO_RELEASE=true          # agent captures + pays out automatically when every deliverable passes
PORT=8787
